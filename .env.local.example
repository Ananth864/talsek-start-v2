# Copy to .env.local and fill in. Secrets here are gitignored — never commit.

# --- Supabase (server-side; never exposed to the client) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon public...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # admin/webhook/cron flows; optional for the tracer bullet

# --- Supabase (client-side; VITE_ prefix, publishable) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon public...

# --- Google OAuth (ticket #3) ---
VITE_GOOGLE_CLIENT_ID=

# --- Sentry (optional; leave DSN blank to disable) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# --- Resend (ticket #15 invite; #17 — notifications/email) ---
# Optional locally: without RESEND_API_KEY (or with EMAIL_STUB=1) invite sends no-op.
RESEND_API_KEY=
# RESEND_INVITE_FROM=Talsek <no-reply@talsek.com>
# RESEND_INVITE_REPLY_TO=
# RESEND_INVITE_SUBJECT=
# Playwright sets EMAIL_STUB=1 for E2E_TARGET=new.
# EMAIL_STUB=1

# --- AI providers (ticket #9 — resume/match/email pipeline) ---
GROK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Dodo payments (ticket #13 — billing) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
APP_ENV=development
# Playwright sets BILLING_STUB=1 for E2E_TARGET=new (skips live Dodo calls).
# BILLING_STUB=1

# --- Cron route guard (ticket #14 — shared secret header for /api/cron/*) ---
CRON_SECRET=

# --- Upstash Redis (ticket #11 — Applicant form IP rate limits) ---
# Optional locally: without these the port uses an in-process sliding window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Playwright E2E: a real Member (recruiter) account in your Supabase project ---
E2E_EMAIL=
E2E_PASSWORD=
