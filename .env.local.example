# --- Supabase (server-side; never exposed to the client) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...

# --- Supabase (client-side; VITE_ prefix, safe to expose) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# --- Sentry (optional; leave blank to disable) ---
VITE_SENTRY_DSN=

# --- Playwright E2E: a real Member account in your Supabase project ---
E2E_EMAIL=
E2E_PASSWORD=
